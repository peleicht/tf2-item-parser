{
	"compilerOptions": {
		"target": "ES6",
		"module": "node18",
		"moduleResolution": "node16",
		"esModuleInterop": true,
		"declaration": true,
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"outDir": "dist",
		"allowJs": true,
		"paths": {
			"steamcommunity/classes/CEconItem": ["./node_modules/@types/steamcommunity/classes/CEconItem.d.ts"]
		}
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "dist", "test", "types/node-tf2-item-format"]
}
